# Copy to .env.local (or .env.development.local) for local work. Files named .env*.local are
# ignored by git. In Vercel, set the same names under Project → Settings → Environment Variables.
# Every VITE_ value is built into the public JavaScript bundle: only put public values here.

# Real app by default. Set to 1 only for a sample-data demo build.
VITE_DEMO=

# Your Home Assistant address over HTTPS (needed when the app is served from Vercel).
# Example: https://home.example.com:8123
VITE_HA_URL=

# Voice: the parse-groceries Supabase Edge Function and the Supabase publishable key.
# The publishable key is public by design. OpenAI and Anthropic keys go in Supabase secrets,
# never here.
VITE_PARSE_FUNCTION_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# DEV SERVER ONLY. A Home Assistant long-lived access token for `npm run dev`.
# Production builds ignore it. Never set this in Vercel.
VITE_HA_TOKEN=
